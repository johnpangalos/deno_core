impl<'a> deno_core::webidl::WebIdlConverter<'a> for Protocol {
    type Options = ();
    fn convert<C>(
        scope: &mut deno_core::v8::HandleScope<'a>,
        value: deno_core::v8::Local<'a, deno_core::v8::Value>,
        prefix: ::std::borrow::Cow<'static, str>,
        context: C,
        options: &Self::Options,
    ) -> ::std::result::Result<Self, deno_core::webidl::WebIdlError>
    where
        C: Fn() -> ::std::borrow::Cow<'static, str>,
    {
        let _ = options;
        let string = <::std::string::String as deno_core::webidl::WebIdlConverter<
            'a,
        >>::convert(
            scope,
            value,
            prefix.clone(),
            &context,
            &::std::default::Default::default(),
        )?;
        match string.as_str() {
            "foo-bar" => ::std::result::Result::Ok(Self::FooBar),
            "a" => ::std::result::Result::Ok(Self::A),
            "http2-only" => ::std::result::Result::Ok(Self::Http2Only),
            "custom-value" => ::std::result::Result::Ok(Self::Renamed),
            _ => {
                ::std::result::Result::Err(
                    deno_core::webidl::_derive::invalid_enum_value(
                        &prefix,
                        &context,
                        &string,
                        "Protocol",
                    ),
                )
            }
        }
    }
}
