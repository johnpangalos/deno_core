impl<'a> ::deno_core::webidl::WebIdlConverter<'a> for Enumeration {
    type Options = ();
    #[allow(clippy::field_reassign_with_default)]
    fn convert<C>(
        __scope: &mut ::deno_core::v8::HandleScope<'a>,
        __value: ::deno_core::v8::Local<'a, ::deno_core::v8::Value>,
        __prefix: ::std::borrow::Cow<'static, str>,
        __context: C,
        __options: &Self::Options,
    ) -> ::std::result::Result<Self, ::deno_core::webidl::WebIdlError>
    where
        C: Fn() -> ::std::borrow::Cow<'static, str>,
    {
        let __value = <::std::string::String as ::deno_core::webidl::WebIdlConverter<
            'a,
        >>::convert(
            __scope,
            __value,
            __prefix.clone(),
            &__context,
            &::std::default::Default::default(),
        )?;
        match __value.as_str() {
            "foo-bar" => ::std::result::Result::Ok(Self::FooBar),
            "baz" => ::std::result::Result::Ok(Self::Baz),
            "hello" => ::std::result::Result::Ok(Self::World),
            _ => {
                ::std::result::Result::Err(
                    ::deno_core::webidl::WebIdlError::new(
                        __prefix,
                        &__context,
                        ::deno_core::webidl::WebIdlErrorKind::InvalidEnumVariant {
                            converter: "Enumeration",
                            variant: __value,
                        },
                    ),
                )
            }
        }
    }
}
